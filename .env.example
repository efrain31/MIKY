# Copia este archivo a .env y cambia los valores.
POSTGRES_DB=miky
POSTGRES_USER=miky
POSTGRES_PASSWORD=cambia-esta-contraseña

# Primer usuario administrador (se crea al arrancar si no existe ningún admin)
ADMIN_EMAIL=admin@pasteleriasmiky.com
ADMIN_PASSWORD=cambia-esta-contraseña-1

# true cuando el sitio se sirva con HTTPS
COOKIE_SECURE=false
WEB_PORT=8090

# 127.0.0.1 = sólo esta computadora; 0.0.0.0 = visible en la red
WEB_BIND=127.0.0.1
